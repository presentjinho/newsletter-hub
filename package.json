{
  "name": "newsletter-hub",
  "private": true,
  "version": "1.6.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "audit": "npm audit --audit-level=high",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run audit && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit",
    "check-links": "node scripts/check-all-links.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "tailwindcss": "^4.1.14",
    "tslib": "^2.8.1",
    "typescript": "~5.8.2",
    "vite": "^8.3.0"
  }
}
